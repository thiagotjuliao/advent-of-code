# Copy to .env (git-ignored) and fill it in.
#
# AOC_SESSION: the "session" cookie from adventofcode.com
#   Chrome/Firefox -> DevTools -> Application/Storage -> Cookies -> adventofcode.com -> session
#   It lasts about a month; when downloads start failing with 400/500, refresh it.
AOC_SESSION=

# AOC_CONTACT: required by the AoC automation rules — it goes into the User-Agent
# so Eric can reach you if a script of yours ever misbehaves.
AOC_CONTACT=ttj.math@gmail.com
