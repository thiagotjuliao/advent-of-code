# Copie para .env  (git-ignorado) e preencha.
#
# AOC_SESSION: valor do cookie "session" em adventofcode.com
#   Chrome/Firefox -> DevTools -> Application/Storage -> Cookies -> adventofcode.com -> session
#   O cookie dura ~1 mes; quando o download comecar a falhar com 400/500, renove.
AOC_SESSION=

# AOC_CONTACT: exigido pelas regras de automacao do AoC — vai no User-Agent
# para que o Eric consiga te contatar se algum script sair do controle.
AOC_CONTACT=ttj.math@gmail.com
